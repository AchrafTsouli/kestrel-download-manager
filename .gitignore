*.user
ui-preview.png

# Bundled video tool binaries: published once as a release asset and restored with
# scripts/Get-VideoTools.ps1, which checks every file against video-tools/sources.json.
video-tools/*
!video-tools/sources.json
!video-tools/*LICENSE*.txt
!video-tools/FFMPEG-*.txt

# The release signing key never lives in the repository (see scripts/New-UpdateKey.ps1).
*.key
# yt-dlp's published PGP public key (checks yt-dlp updates); no secret in it.
!rust/crates/kestrel-media/src/yt-dlp-public.key

